// ─────────────────────────────────────────────────────────────────────
//  Zellij — ultra-riced config
//
//  Designed for Mac → web-based VM access. No Ctrl+<letter> bindings that
//  collide with browser shortcuts (Ctrl+T, Ctrl+W, Ctrl+N, etc.).
//
//  Leader: Ctrl+;  (also bound to Alt+; for Mac ergonomics — same action)
//  Press leader, then a single key. Or use the always-on Alt+ shortcuts.
//
//  Stack:
//    • Theme       — Catppuccin Mocha
//    • Status bar  — zellaude (Claude Code-aware tabs)
//    • Autolock    — passes keys through to nvim / fzf / lazygit / claude
//    • Attention   — tab badges from Claude Code hooks
//    • Forgot      — which-key cheatsheet (Alt+/ from anywhere)
//    • Sessionizer — fzf project picker  (leader → f)
// ─────────────────────────────────────────────────────────────────────

theme "catppuccin-mocha"
default_layout "default"
default_shell "zsh"
default_mode "normal"
mouse_mode true
copy_on_select true
copy_clipboard "system"
scroll_buffer_size 50000
copy_command "pbcopy"
pane_frames true
simplified_ui false
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000
show_startup_tips false
show_release_notes false
auto_layout true
styled_underlines true
support_kitty_keyboard_protocol true

// ─── PLUGIN DECLARATIONS ─────────────────────────────────────────────
plugins {
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        is_enabled true
        triggers "nvim|vim|fzf|lazygit|claude|btop|htop|less|man|delta|tig|gh|atuin|zoxide|k9s"
        reaction_seconds "0.3"
        print_to_log false
    }
    attention location="file:~/.config/zellij/plugins/zellij-attention.wasm" {
        enabled "true"
        waiting_icon "  "
        completed_icon " 󰄬 "
    }
    forgot location="file:~/.config/zellij/plugins/zellij-forgot.wasm"
    zellaude location="file:~/.config/zellij/plugins/zellaude.wasm"

    // Built-ins
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" { welcome_screen true; }
    filepicker location="zellij:strider" { cwd "/"; }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
}

// Load headless plugins at start
load_plugins {
    autolock
    attention
}

// ─── KEYBINDS ────────────────────────────────────────────────────────
keybinds clear-defaults=true {

    // ─── NORMAL MODE ─────────────────────────────────────────────────
    normal {
        // Leader → enter tmux command mode (both Ctrl+; and Alt+; work)
        bind "Ctrl ;" "Alt ;" { SwitchToMode "tmux"; }

        // Snappier autolock — re-evaluate after Enter is pressed
        bind "Enter" {
            WriteChars "\u{000D}"
            MessagePlugin "autolock" {}
        }
    }

    // ─── TMUX (leader sublayer) — single keystroke after leader ─────
    tmux {
        bind "Ctrl ;" "Alt ;" "Esc" { SwitchToMode "Normal"; }

        // Panes
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "\\" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "F" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "w" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "p" { SwitchToMode "Pane"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }

        // Pane focus
        bind "h" "Left"  { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down"  { MoveFocus "Down"; }
        bind "k" "Up"    { MoveFocus "Up"; }
        bind "o" { FocusNextPane; }

        // Project picker (zellij-sessionizer via fzf)
        bind "f" {
            Run "zellij-sessionizer" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }

        // Tabs
        bind "t" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; }
        bind "N" { GoToPreviousTab; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }
        bind "T" { ToggleTab; SwitchToMode "Normal"; }

        // Layouts (named layouts in layouts/ directory)
        bind "L" { SwitchToMode "Normal"; NewTab { layout "dev"; }; }
        bind "C" { SwitchToMode "Normal"; NewTab { layout "claude"; }; }
        bind "M" { SwitchToMode "Normal"; NewTab { layout "monitor"; }; }
        bind "[" { PreviousSwapLayout; SwitchToMode "Normal"; }
        bind "]" { NextSwapLayout; SwitchToMode "Normal"; }

        // Modes
        bind "r" { SwitchToMode "Resize"; }
        bind "s" { SwitchToMode "Scroll"; }
        bind "S" { SwitchToMode "Session"; }
        bind "m" { SwitchToMode "Move"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }

        // Plugins
        bind "?" {
            LaunchOrFocusPlugin "forgot" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
        bind "g" { SwitchToMode "Locked"; }
        bind "d" { Detach; }
        bind "q" { Quit; }
        bind "a" {
            LaunchOrFocusPlugin "about" { floating true; }
            SwitchToMode "Normal"
        }
        bind "P" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }

    // ─── LOCKED — keys pass through to nvim/fzf/etc. ────────────────
    locked {
        bind "Ctrl ;" "Alt ;" { SwitchToMode "Normal"; }
        // Re-enable autolock + unlock
        bind "Alt z" {
            MessagePlugin "autolock" { payload "enable"; }
            SwitchToMode "Normal"
        }
    }

    // ─── PANE MODE ───────────────────────────────────────────────────
    pane {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "h" "Left"  { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down"  { MoveFocus "Down"; }
        bind "k" "Up"    { MoveFocus "Up"; }
        bind "p" { SwitchFocus; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
    }

    // ─── RESIZE MODE ─────────────────────────────────────────────────
    resize {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "h" "Left"  { Resize "Increase Left"; }
        bind "j" "Down"  { Resize "Increase Down"; }
        bind "k" "Up"    { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }

    // ─── MOVE MODE ───────────────────────────────────────────────────
    move {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "n" "Tab"   { MovePane; }
        bind "h" "Left"  { MovePane "Left"; }
        bind "l" "Right" { MovePane "Right"; }
        bind "j" "Down"  { MovePane "Down"; }
        bind "k" "Up"    { MovePane "Up"; }
    }

    // ─── SCROLL MODE ─────────────────────────────────────────────────
    scroll {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up"   { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp"   { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
    }

    search {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "n" { Search "Down"; }
        bind "p" { Search "Up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // ─── SESSION MODE ────────────────────────────────────────────────
    session {
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true; move_to_focused_tab true;
            }
            SwitchToMode "Normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true; move_to_focused_tab true;
            }
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true; move_to_focused_tab true;
            }
            SwitchToMode "Normal"
        }
    }

    // ─── ALWAYS-ON (no leader needed) ────────────────────────────────
    shared_except "locked" "renametab" "renamepane" "entersearch" {
        // Focus + tab traversal (browser-safe)
        bind "Alt h" { MoveFocusOrTab "Left"; }
        bind "Alt l" { MoveFocusOrTab "Right"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        // New / resize
        bind "Alt n" { NewPane; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        // Tab shuffling
        bind "Alt i" { MoveTab "Left"; }
        bind "Alt o" { MoveTab "Right"; }
        // Swap layouts
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        // Which-key cheatsheet (always one keystroke away)
        bind "Alt /" {
            LaunchOrFocusPlugin "forgot" {
                floating true
                move_to_focused_tab true
            }
        }
        // Manual lock toggle (matches autolock plugin convention)
        bind "Alt z" {
            MessagePlugin "autolock" { payload "disable"; }
            SwitchToMode "Locked"
        }
    }

}

// ─── UI ──────────────────────────────────────────────────────────────
ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}
